# ==============================================================================
# InsectID Environment Configuration (.env)
# Powered exclusively by Ollama (Local & Cloud Vision AI)
# ==============================================================================

INSECT_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2-vision
OLLAMA_API_KEY=


# Scanning Rate Limits
RATE_LIMIT_PER_MIN=12
DAILY_SCAN_CAP=500
HOST=0.0.0.0
PORT=8000
